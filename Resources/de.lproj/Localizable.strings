/* Sway — de. Keys are the English text. */

"Start wrapping up what you're doing." = "Bring langsam zu Ende, woran du gerade arbeitest.";
"Start now" = "Jetzt starten";
"+%d min" = "+%d Min.";
"Break in %d:%02d" = "Pause in %d:%02d";
"Breathe in slowly. Breathe out even slower." = "Atme langsam ein. Atme noch langsamer aus.";
"Nothing on that screen is going anywhere. You can rest." = "Nichts auf diesem Bildschirm läuft dir davon. Du darfst dich ausruhen.";
"Look at something far away and let your eyes soften." = "Schau in die Ferne und lass deine Augen entspannen.";
"Roll your shoulders back. Unclench your jaw." = "Roll die Schultern nach hinten. Lockere den Kiefer.";
"You've done enough for now. This moment is just for you." = "Du hast für den Moment genug getan. Dieser Augenblick gehört dir.";
"Stand up, stretch, and feel your feet on the ground." = "Steh auf, streck dich und spüre deine Füße auf dem Boden.";
"Drink some water. Your future self says thanks." = "Trink etwas Wasser. Dein zukünftiges Ich sagt danke.";
"Let your thoughts drift by like clouds." = "Lass deine Gedanken vorbeiziehen wie Wolken.";
"Rest is part of the work, not a break from it." = "Ausruhen gehört zur Arbeit, es ist keine Pause davon.";
"Notice three things you can hear right now." = "Achte auf drei Dinge, die du gerade hören kannst.";
"Be gentle with yourself. You're doing fine." = "Sei nachsichtig mit dir. Du machst das gut.";
"A calm mind solves problems faster. Let it settle." = "Ein ruhiger Kopf löst Probleme schneller. Lass ihn zur Ruhe kommen.";
