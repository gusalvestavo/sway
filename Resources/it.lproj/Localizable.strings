/* Sway — it. Keys are the English text. */

"Start wrapping up what you're doing." = "Inizia a concludere quello che stai facendo.";
"Start now" = "Inizia ora";
"+%d min" = "+%d min";
"Break in %d:%02d" = "Pausa tra %d:%02d";
"Breathe in slowly. Breathe out even slower." = "Inspira lentamente. Espira ancora più lentamente.";
"Nothing on that screen is going anywhere. You can rest." = "Niente su quello schermo scapperà via. Puoi riposarti.";
"Look at something far away and let your eyes soften." = "Guarda qualcosa in lontananza e lascia rilassare gli occhi.";
"Roll your shoulders back. Unclench your jaw." = "Porta indietro le spalle. Rilassa la mascella.";
"You've done enough for now. This moment is just for you." = "Per ora hai fatto abbastanza. Questo momento è solo per te.";
"Stand up, stretch, and feel your feet on the ground." = "Alzati, fai stretching e senti i piedi a terra.";
"Drink some water. Your future self says thanks." = "Bevi un po’ d’acqua. Il te del futuro ringrazia.";
"Let your thoughts drift by like clouds." = "Lascia scorrere i pensieri come nuvole.";
"Rest is part of the work, not a break from it." = "Il riposo fa parte del lavoro, non è una pausa dal lavoro.";
"Notice three things you can hear right now." = "Nota tre suoni che riesci a sentire adesso.";
"Be gentle with yourself. You're doing fine." = "Sii gentile con te stesso. Stai andando bene.";
"A calm mind solves problems faster. Let it settle." = "Una mente calma risolve i problemi più in fretta. Lasciala posare.";
