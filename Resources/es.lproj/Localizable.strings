/* Sway — es. Keys are the English text. */

"Start wrapping up what you're doing." = "Ve terminando lo que estás haciendo.";
"Start now" = "Empezar ya";
"+%d min" = "+%d min";
"Break in %d:%02d" = "Descanso en %d:%02d";
"Breathe in slowly. Breathe out even slower." = "Inhala despacio. Exhala aún más despacio.";
"Nothing on that screen is going anywhere. You can rest." = "Nada en esa pantalla se va a ir a ningún lado. Puedes descansar.";
"Look at something far away and let your eyes soften." = "Mira algo a lo lejos y deja que tus ojos se relajen.";
"Roll your shoulders back. Unclench your jaw." = "Lleva los hombros hacia atrás. Relaja la mandíbula.";
"You've done enough for now. This moment is just for you." = "Ya has hecho suficiente por ahora. Este momento es solo para ti.";
"Stand up, stretch, and feel your feet on the ground." = "Levántate, estírate y siente los pies en el suelo.";
"Drink some water. Your future self says thanks." = "Bebe un poco de agua. Tu yo del futuro te lo agradece.";
"Let your thoughts drift by like clouds." = "Deja que tus pensamientos pasen como nubes.";
"Rest is part of the work, not a break from it." = "Descansar es parte del trabajo, no una pausa de él.";
"Notice three things you can hear right now." = "Fíjate en tres cosas que puedas oír ahora mismo.";
"Be gentle with yourself. You're doing fine." = "Sé amable contigo. Lo estás haciendo bien.";
