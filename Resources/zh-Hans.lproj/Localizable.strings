"Warn me how many minutes before a break?" = "在休息前几分钟提醒？";
"Remind me every how many minutes?" = "每隔几分钟提醒？";
"Break length in minutes?" = "休息时长（分钟）？";
"Save" = "存储";
"Cancel" = "取消";
"Off" = "关闭";
"%d sec" = "%d 秒";
"%d min" = "%d 分钟";

/* Away from the computer */
"Away" = "离开";
"You were away for %@" = "你离开了 %@";
"The countdown waited for you." = "倒计时一直在等你。";
"That counts as a break, so the timer started over." = "这算作一次休息，计时器已重新开始。";

/* Settings window */
"Settings" = "设置";
"Settings…" = "设置…";
"Pause when away after" = "离开多久后暂停";
"No keyboard, mouse or trackpad input for this long stops the countdown." = "在这段时间内没有键盘、鼠标或触控板操作，倒计时会停止。";
"Language" = "语言";
"Same as the system" = "跟随系统";
"Pause after how many minutes away?" = "离开多少分钟后暂停？";

/* Brand */
"Find your flow." = "找到你的节奏。";

/* New-day greeting */
"Good morning, %@!" = "早上好，%@！";
"Good afternoon, %@!" = "下午好，%@！";
"Good evening, %@!" = "晚上好，%@！";
"Good morning!" = "早上好！";
"Good afternoon!" = "下午好！";
"Good evening!" = "晚上好！";
"Your countdown has started: next break in %@." = "倒计时已开始：距离下次休息还有 %@。";
"Let's go!" = "出发吧！";
"A brand-new day. Let's make it a great one!" = "崭新的一天。让我们把它过得精彩！";
"Fresh start, fresh ideas. You've got this!" = "新的开始，新的想法。你一定行！";
"Today is full of possibilities. Go get them!" = "今天充满了可能性。去抓住它们！";
"Small steps add up. Let's take the first one!" = "小小的步伐会积少成多。迈出第一步吧！";
"You showed up, and that's the hardest part. Let's go!" = "你来了，这已经是最难的部分。出发吧！";
"Big things are built one focused hour at a time." = "伟大的事情，是一小时一小时专注积累出来的。";
"New day, new energy. Let's do something amazing!" = "新的一天，新的能量。一起做点了不起的事吧！";
"You're capable of more than you think. Show today!" = "你比自己想象的更有能力。今天就证明给自己看！";
"Today's a great day to make progress. Ready, set, go!" = "今天是取得进展的好日子。预备，开始！";
"Your best work is still ahead of you. Let's start!" = "你最好的作品还在前方。开始吧！";
