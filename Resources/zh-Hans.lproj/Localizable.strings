/* Sway — zh-Hans. Keys are the English text. */

"Start wrapping up what you're doing." = "开始收尾手头的工作吧。";
"Start now" = "立即开始";
"+%d min" = "+%d 分钟";
"Break in %d:%02d" = "%d:%02d 后休息";
"Breathe in slowly. Breathe out even slower." = "慢慢吸气，再更慢地呼气。";
"Nothing on that screen is going anywhere. You can rest." = "屏幕上的东西不会跑掉，你可以休息一下。";
"Look at something far away and let your eyes soften." = "看看远处，让眼睛放松。";
"Roll your shoulders back. Unclench your jaw." = "向后转转肩膀，放松下颌。";
"You've done enough for now. This moment is just for you." = "你暂时已经做得够多了，这一刻只属于你。";
"Stand up, stretch, and feel your feet on the ground." = "站起来伸个懒腰，感受双脚踩在地上。";
"Drink some water. Your future self says thanks." = "喝点水吧，未来的你会感谢你。";
"Let your thoughts drift by like clouds." = "让思绪像云一样飘过。";
"Rest is part of the work, not a break from it." = "休息是工作的一部分，而不是工作的中断。";
"Notice three things you can hear right now." = "留意此刻能听到的三种声音。";
"Be gentle with yourself. You're doing fine." = "对自己温柔一点，你做得很好。";
"A calm mind solves problems faster. Let it settle." = "平静的头脑解决问题更快，让它沉静下来。";
"Skip break" = "跳过休息";
"Lock screen" = "锁定屏幕";
"Break's over" = "休息结束";
"Time for a break" = "该休息了";
"Back to work" = "回到工作";
"Break %@" = "休息 %@";
"Break done" = "休息完成";
"Paused %@" = "已暂停 %@";
"Next break in" = "距下次休息";
"On a break" = "休息中";
"Welcome back" = "欢迎回来";
"%@ left" = "剩余 %@";
"Paused" = "已暂停";
"End break now" = "立即结束休息";
"Take a break now" = "现在休息";
"Resume" = "继续";
"Pause" = "暂停";
"Restart timer" = "重新计时";
"Remind me every" = "提醒间隔";
"Break length" = "休息时长";
