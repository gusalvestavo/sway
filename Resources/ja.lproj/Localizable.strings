/* Sway — ja. Keys are the English text. */

"Start wrapping up what you're doing." = "作業のきりをつけ始めましょう。";
"Start now" = "今すぐ開始";
"+%d min" = "+%d分";
"Break in %d:%02d" = "休憩まで %d:%02d";
"Breathe in slowly. Breathe out even slower." = "ゆっくり息を吸って、さらにゆっくり吐きましょう。";
"Nothing on that screen is going anywhere. You can rest." = "画面の中のものは逃げません。休んで大丈夫です。";
"Look at something far away and let your eyes soften." = "遠くを見て、目の力を抜きましょう。";
"Roll your shoulders back. Unclench your jaw." = "肩を後ろに回して、あごの力を抜きましょう。";
